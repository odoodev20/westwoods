<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inventory adjustment / quant list: show physical count field -->
    <record id="view_stock_quant_tree_inventory_editable_westwoods" model="ir.ui.view">
        <field name="name">stock.quant.tree.inventory.editable.westwoods</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='inventory_quantity']" position="before">
                <field name="x_counted_physical_units" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
