<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Delivery slip (Leveringsbon) — Odoo 19 structure.
        Ordered / Delivered = physical units (e.g. 6 platen)
        Under product: Volume: 18.75 m²
        Headers/footers unchanged.
    -->
    <template id="report_delivery_document_westwoods" inherit_id="stock.report_delivery_document">
        <!-- Volume under product name (not-done moves table) -->
        <xpath expr="//table[@name='stock_move_table']/tbody/tr/td[1]" position="inside">
            <t t-if="move.product_id.product_tmpl_id.x_product_flow">
                <div class="text-muted small"
                     t-esc="move.product_id._ww_report_volume_label(move.product_uom_qty or 0.0)"/>
            </t>
        </xpath>

        <!-- Ordered qty → physical label -->
        <xpath expr="//table[@name='stock_move_table']/tbody/tr/td[2]" position="replace">
            <td class="o_td_quantity text-end">
                <t t-if="move.product_id.product_tmpl_id.x_product_flow">
                    <t t-set="tech" t-value="move.product_id._get_active_technical_value() or 0.0"/>
                    <t t-set="physical" t-value="(move.product_uom_qty / tech) if tech else 0.0"/>
                    <span class="text-nowrap"
                          t-esc="move.product_id._ww_report_physical_label(physical)"/>
                </t>
                <t t-else="">
                    <span t-out="format_number(move.product_uom_qty)" class="text-nowrap"/>
                    <span t-field="move.product_uom" groups="uom.group_uom"/>
                </t>
            </td>
        </xpath>

        <!-- Delivered qty → physical label -->
        <xpath expr="//table[@name='stock_move_table']/tbody/tr/td[3]" position="replace">
            <td class="o_td_quantity text-end">
                <t t-if="move.product_id.product_tmpl_id.x_product_flow">
                    <t t-set="tech" t-value="move.product_id._get_active_technical_value() or 0.0"/>
                    <t t-set="base" t-value="move.quantity or 0.0"/>
                    <t t-set="physical" t-value="(base / tech) if tech else 0.0"/>
                    <span class="text-nowrap"
                          t-esc="move.product_id._ww_report_physical_label(physical)"/>
                </t>
                <t t-else="">
                    <span t-out="format_number(move.quantity)" class="text-nowrap"/>
                    <span t-field="move.product_uom" groups="uom.group_uom"/>
                </t>
            </td>
        </xpath>
    </template>

    <!-- Aggregated lines (done transfers) -->
    <template id="stock_report_delivery_aggregated_westwoods"
              inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <!-- Product cell: volume subtitle -->
        <xpath expr="//tr/td[1]" position="inside">
            <t t-set="product" t-value="aggregated_lines[line].get('product')"/>
            <t t-if="product and product.product_tmpl_id.x_product_flow">
                <div class="text-muted small"
                     t-esc="product._ww_report_volume_label(aggregated_lines[line].get('qty_ordered') or aggregated_lines[line].get('quantity') or 0.0)"/>
            </t>
        </xpath>

        <xpath expr="//td[@name='move_line_aggregated_qty_ordered']" position="replace">
            <td class="text-end" name="move_line_aggregated_qty_ordered">
                <t t-set="product" t-value="aggregated_lines[line].get('product')"/>
                <t t-set="qty" t-value="aggregated_lines[line].get('qty_ordered', 0.0)"/>
                <t t-if="product and product.product_tmpl_id.x_product_flow">
                    <t t-set="tech" t-value="product._get_active_technical_value() or 0.0"/>
                    <t t-set="physical" t-value="(qty / tech) if tech else 0.0"/>
                    <span t-esc="product._ww_report_physical_label(physical)"/>
                </t>
                <t t-else="">
                    <span t-out="format_number(qty)"/>
                    <span t-out="aggregated_lines[line]['product_uom'].name" groups="uom.group_uom"/>
                </t>
            </td>
        </xpath>

        <xpath expr="//td[@name='move_line_aggregated_quantity']" position="replace">
            <td class="text-end" name="move_line_aggregated_quantity">
                <t t-set="product" t-value="aggregated_lines[line].get('product')"/>
                <t t-set="qty" t-value="aggregated_lines[line].get('quantity', 0.0)"/>
                <t t-if="product and product.product_tmpl_id.x_product_flow">
                    <t t-set="tech" t-value="product._get_active_technical_value() or 0.0"/>
                    <t t-set="physical" t-value="(qty / tech) if tech else 0.0"/>
                    <span t-esc="product._ww_report_physical_label(physical)"/>
                </t>
                <t t-else="">
                    <span t-out="format_number(qty)"/>
                    <span t-out="aggregated_lines[line]['product_uom'].name" groups="uom.group_uom"/>
                </t>
            </td>
        </xpath>
    </template>
</odoo>
